prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$base = 'D:\\Obsidian (Installed)\\Vault Folder (Non Standard Folder)\\Ken''s Vault\\05 Mirror\\Repo Mirror'; $docsIndex = Join-Path $base 'docs\\Index.md'; $codexIndex = Join-Path $base 'docs\\codex\\Index.md'; $setupIndex = Join-Path $base 'docs\\setup\\Index.md'; $rootIndex = Join-Path $base 'root-artifacts\\Index.md'; function Wikify([string]$path) { $rel = $path.Substring($base.Length + 1) -replace '\\\\','/'; return \"[[${rel}]]\" } function GetFileLines([string]$folder) { Get-ChildItem -Path $folder -File | Sort-Object Name | ForEach-Object { \"- $(Wikify $_.FullName)\" } } $docsFolder = Join-Path $base 'docs'; $codexFolder = Join-Path $base 'docs\\codex'; $setupFolder = Join-Path $base 'docs\\setup'; $rootFolder = Join-Path $base 'root-artifacts'; $docsLines = @('# Docs Index','','This note indexes the files in `docs/`.','','## Connected Hubs','- [[00 Home/Vault Map]]','- [[10 Canonical/Canonical Control]]','- [[20 Current/Live State]]','- [[60 Validation/Validation Ledger]]','- [[70 Logs/Execution Timeline]]','- [[90 External Inputs/Client Onboarding]]','','## Subfolder Branches','- [[05 Mirror/Repo Mirror/docs/codex/Index]]','- [[05 Mirror/Repo Mirror/docs/setup/Index]]','','## Files') + (GetFileLines $docsFolder); Set-Content -Path $docsIndex -Value ($docsLines -join \"`n\") -Encoding UTF8; $codexLines = @('# Docs / Codex Index','','This note indexes the files in `docs/codex/`.','','## Connected Hubs','- [[00 Home/Vault Map]]','- [[30 Architecture/Stack Overview]]','- [[95 Plans/Development Plan]]','','## Files') + (GetFileLines $codexFolder); Set-Content -Path $codexIndex -Value ($codexLines -join \"`n\") -Encoding UTF8; $setupLines = @('# Docs / Setup Index','','This note indexes the files in `docs/setup/`.','','## Connected Hubs','- [[00 Home/Vault Map]]','- [[90 External Inputs/Client Onboarding]]','- [[95 Plans/Development Plan]]','','## Files') + (Get